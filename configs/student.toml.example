[project]
name = "REPLACE WITH YOUR PRODUCT NAME"
intended_user = "REPLACE WITH A SPECIFIC USER"

[dataset]
adapter = "csv"
name = "REPLACE WITH DATASET NAME"
source = "REPLACE WITH SOURCE AND RETRIEVAL DATE"
license = "REPLACE WITH LICENSE OR ACCESS TERMS"
path = "data/local/observations.csv"
observation_unit = "REPLACE WITH WHAT ONE ROW REPRESENTS"
identifier = "observation_id"
feature_columns = ["feature_1", "feature_2"]

[tasks.regression]
name = "REPLACE OR REMOVE WHEN MATHEMATICALLY INAPPLICABLE"
target = "regression_target"
metric = "root_mean_squared_error"

[tasks.classification]
name = "REPLACE OR REMOVE WHEN MATHEMATICALLY INAPPLICABLE"
target = "classification_target"
positive_event = "DEFINE THE EVENT WHEN BINARY"
metric = "balanced_accuracy"

[tasks.unsupervised]
name = "REPLACE WITH A SCIENTIFIC STRUCTURE QUESTION"
metric = "REPLACE WITH STABILITY, RECONSTRUCTION, DENSITY, OR OTHER EVIDENCE"

[split]
random_state = 438
test_fraction = 0.25
# group_column = "subject_id"
# time_column = "measurement_time"
